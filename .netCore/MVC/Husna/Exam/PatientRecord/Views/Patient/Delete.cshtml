@model PatientRecord.Dto.PatientDto

@{
    ViewData["Title"] = "Delete Patient";
}

<h2>Delete Patient</h2>

<h4>Are you sure you want to delete this patient?</h4>
<hr />

<p><strong>Name:</strong> @Model.Name</p>
<p>Age:@Model.Age</p>
<p>Gender:@Model.Gender</p>
<p>Address: @Model.ContactNumber</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit">Delete</button>
    <a asp-action="GetAllPatients">Cancel</a>
</form>
