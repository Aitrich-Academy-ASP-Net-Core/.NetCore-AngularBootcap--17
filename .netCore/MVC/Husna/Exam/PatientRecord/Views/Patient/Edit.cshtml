@model PatientRecord.Dto.PatientDto;
@{
    ViewData["Title"] = "Edit Patient";
}
<h2>Edit Patient</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <partial name="PatientForm" model="Model" />

    <button type="submit">Save</button>
    <a asp-action="GetAllPatients">Cancel</a>

</form>
