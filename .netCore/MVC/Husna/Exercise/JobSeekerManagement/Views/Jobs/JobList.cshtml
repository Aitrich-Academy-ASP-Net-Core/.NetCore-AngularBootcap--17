@model IEnumerable<JobSeekerManagement.Dto.JobDto>
@{
    Layout = "_Layout"; 
}

<div style="display:flex; min-height:100vh;">

    
    <div style="width:220px; background:#007bff; color:white; padding:20px; border-right:1px solid #0056b3;">
        <h2 style="color:white; margin-bottom:30px;">HireMe Now</h2>
        <ul style="list-style:none; padding:0; margin:0;">
            <li style="margin:15px 0;"><a href="/Messages" style="color:white; text-decoration:none;">Messages</a></li>
            <li style="margin:15px 0;"><a asp-controller="Jobs" asp-action="JobList" style="color:white; text-decoration:none;">All Jobs</a></li>
            <li style="margin:15px 0;"><a asp-controller="Application" asp-action="MyApplications" style="color:white; text-decoration:none;">My Applications</a></li>
            <li style="margin:15px 0;"><a asp-controller="Profile" asp-action="MyProfile" style="color:white; text-decoration:none;">My Profile</a></li>
            <li style="margin:15px 0;"><a href="/Settings" style="color:white; text-decoration:none;">Settings</a></li>
        </ul>
    </div>

  
    <div style="flex:1; padding:20px; display:flex; gap:20px;">

       
        <div style="width:40%; border-right:1px solid #ddd; padding-right:15px;">
            <h2>All Jobs</h2>
            @foreach (var job in Model)
            {
                <div style="margin-bottom:15px; padding:10px; border:1px solid #eee; border-radius:6px;">
                    <h4>@job.Title</h4>
                    <p>@job.Company - @job.Location</p>
                    <p><strong>@job.EmploymentType</strong> | @job.SalaryRange</p>
                    <a asp-action="JobList" asp-route-id="@job.Id">View Details</a>
                </div>
            }
        </div>

      
        <div style="width:60%; padding-left:15px;">
            <h2>Job Details</h2>
            @if (ViewBag.SelectedJob != null)
            {
                var detail = ViewBag.SelectedJob as JobSeekerManagement.Dto.JobDto;

                <div style="padding:20px; border:1px solid #ddd; border-radius:8px;">
                    <h3>@detail.Title</h3>
                    <p><strong>Company:</strong> @detail.Company</p>
                    <p><strong>Location:</strong> @detail.Location</p>
                    <p><strong>Type:</strong> @detail.EmploymentType</p>
                    <p><strong>Salary:</strong> @detail.SalaryRange</p>
                    <p><strong>Description:</strong> @detail.Description</p>

                    <form asp-controller="Application" asp-action="ApplyJob" method="post">
                        <input type="hidden" name="jobId" value="@detail.Id" />
                        <button type="submit" style="background:#1e90ff;color:white;padding:10px 15px;border:none;border-radius:5px;cursor:pointer;">
                            Apply Job
                        </button>

                        @if (TempData["Message"] != null)
                        {
                            <div style="color:green; font-weight:bold; margin-top:10px;">
                                @TempData["Message"]
                            </div>
                        }
                    </form>
                </div>

            }
            else
            {
                <p>Select a job from the left to view details.</p>
            }
        </div>
    </div>
</div>
