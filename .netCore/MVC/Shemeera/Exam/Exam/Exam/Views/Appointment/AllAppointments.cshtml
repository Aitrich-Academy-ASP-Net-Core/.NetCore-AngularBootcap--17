@{
}
@model List<Exam.Models.Appointment>

<h2>All Appointments</h2>

<table border="1" cellpadding="5" cellspacing="0">
    <thead>
        <tr>
            <th>Patient Email</th>
            <th>Doctor</th>
            <th>Specialization</th>
            <th>Appointment Date & Time</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var appt in Model)
        {
            <tr>
                <td>@appt.Patient.Email</td>
                <td>@appt.Doctor.Name</td>
                <td>@appt.Doctor.Specialization</td>
                <td>@appt.AppointmentDateTime.ToString("g")</td>
            </tr>
        }
    </tbody>
</table>

<p><a asp-controller="Account" asp-action="Logout">Logout</a></p>