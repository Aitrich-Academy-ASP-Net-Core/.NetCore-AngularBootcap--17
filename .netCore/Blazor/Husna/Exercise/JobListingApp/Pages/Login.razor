@page "/"
@inject IAuthService AuthService
@inject NavigationManager NavigationManager
@inject ProtectedSessionStorage SessionStorage

<div class="login-wrapper d-flex align-items-center justify-content-center vh-100 bg-light">
    <div class="login-container d-flex rounded shadow-lg overflow-hidden" style="width: 900px;">
     
        <div class="login-form px-5 bg-white " style="width: 50%;">
            <div class="text-center mb-4">
                <img src="images/computer-security-with-login-password-padlock.jpg" alt="Login" width="60" />
                <h3 class="fw-bold mt-3">Welcome Back</h3>
            </div>
            <button class="btn btn-outline-dark w-100 mb-3">
                <img src="https://developers.google.com/identity/images/g-logo.png" alt="Google" width="20" class="me-2" />
                Log in with Google
            </button>

            <div class="text-center text-muted mb-3">OR LOGIN WITH EMAIL</div>


            <EditForm Model="@loginModel" OnValidSubmit="LoginAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <InputText @bind-Value="loginModel.Email" class="form-control" placeholder="Enter email" />
                </div>
                <div class="mb-3">
                    <InputText @bind-Value="loginModel.Password" type="password" class="form-control" placeholder="Enter password" />
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox class="form-check-input" id="rememberMe" @bind-Value="rememberMe" />
                    <label class="form-check-label" for="rememberMe">Keep me logged in</label>
                </div>

                <button type="submit" class="btn btn-primary w-100">Login</button>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="mt-3 alert alert-danger">@message</div>
                }

                <div class="mt-3 text-center">
                    <small>Don’t have an account yet?</small> <a href="/register">Register</a>
                </div>
            </EditForm>
        </div>

        <!-- Right Side: Image -->
        <div class="login-image d-none d-md-block" style="width: 50%;">
            <img src="images/Teal Padlock on Pastel Green.png" class="h-100 w-100 object-fit-cover" />
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string? message;
    private bool rememberMe;

    private async Task LoginAsync()
    {
        var jobSeeker = await AuthService.AuthenticateAsync(loginModel.Email, loginModel.Password);

        if (jobSeeker != null)
        {
            await SessionStorage.SetAsync("jobSeeker", jobSeeker);
            NavigationManager.NavigateTo("/joblist");
        }
        else
        {
            message = "Invalid email or password.";
        }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}
