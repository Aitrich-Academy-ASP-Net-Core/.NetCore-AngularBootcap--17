@page
@model Mini_project.Pages.Menu.DeleteModel
@{
}
<h1>Delete Company Member</h1>
<h2>Do You want to delete this Member?</h2>
<div>
    <h2>Member details</h2>
    <dl>
        <dt>Member Name:</dt>
        <dd>@Model.Newmember.Name</dd>
        
    </dl>
    <dl>
        <dt>Age</dt>
        <dd>@Model.Newmember.Age</dd>
    </dl>
   
    <dl>
        <dt>Role</dt>
        <dd>@Model.Newmember.Role</dd>
    </dl>
    <dl>
        <dt>Position</dt>
        <dd>@Model.Newmember.Position</dd>
    </dl>
</div>
<div class="form-group">
    <form method="post">
        <input type="hidden" asp-for="Newmember.MemberId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
