@page
@model Mini_project.Pages.Menu.RegisterModel
@{
}
<h2>Register</h2>

<form method="post">
    <label>Username:</label>
    <input type="text" asp-for="NewUser.Username" required />
    <span asp-validation-for="NewUser.Username" class="text-danger"></span>

    <label>Email:</label>
    <input type="email" asp-for="NewUser.Email" required />
    <span asp-validation-for="NewUser.Email" class="text-danger"></span>

    <label>Password:</label>
    <input type="password" asp-for="NewUser.Password" required />
    <span asp-validation-for="NewUser.Password" class="text-danger"></span>

    <button type="submit">Register</button>
</form>

<a href="Login">Already have an account? Login</a>
