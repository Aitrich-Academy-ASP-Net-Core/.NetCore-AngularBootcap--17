@page "{id:int}"  
@model Mini_project.Pages.Menu.EditModel
@{
    ViewData["Title"] = "Edit Member";
}
<h2>Edit Member</h2>

<form method="post">
    <input type="hidden" asp-for="NewMember.MemberId" />
    <div class="form-group">
        <label asp-for="NewMember.Name"></label>
        <input asp-for="NewMember.Name" class="form-control" />
        <span asp-validation-for="NewMember.Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NewMember.Age"></label>
        <input asp-for="NewMember.Age" class="form-control" />
        <span asp-validation-for="NewMember.Age" class="text-danger"></span>
    </div>
    

    <div class="form-group">
        <label asp-for="NewMember.Position"></label>
        <input asp-for="NewMember.Position" class="form-control" />
        <span asp-validation-for="NewMember.Position" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="NewMember.Role" class="control-label"></label>
        <select asp-for="NewMember.Role" class="form-control">
            <option value="Junior">Junior</option>
            <option value="Mid-Level">Mid-Level</option>
            <option value="Senior">Senior</option>
        </select>
        <span asp-validation-for="NewMember.Role" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-page="Index2" class="btn btn-secondary">Cancel</a>
</form>
