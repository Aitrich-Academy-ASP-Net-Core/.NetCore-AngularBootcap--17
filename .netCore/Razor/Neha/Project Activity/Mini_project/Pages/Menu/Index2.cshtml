@page
@model Mini_project.Pages.Menu.IndexModel
@{
    ViewData["Title"] = "My Company Members";
}

<h2>My Company Members</h2>

<a asp-page="Create" class="btn btn-primary">Create Member</a>
    <table class="table table-bordered">
        <thead>
            <tr>
            <td>MemberId</td>
             <th>Name</th>
             <th>Age</th>
             <th>Position</th>
              <th>Role</th>
               
              <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var det in Model.Members)
            {
                <tr>
                <td>@det.MemberId</td>
                    <td>@det.Name</td>
                    <td>@det.Age</td>
                    <td>@det.Position</td>
                    <td>@det.Role</td>
                   
                    <td>
                        <a asp-page="Edit" asp-route-id="@det.MemberId" class="btn btn-warning">Edit</a>
                        <a asp-page="Delete" asp-route-id="@det.MemberId" class="btn btn-danger">Delete</a>


                    </td>
                </tr>
            }
        </tbody>
    </table>
    