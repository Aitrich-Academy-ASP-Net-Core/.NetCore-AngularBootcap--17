@page
@model Workshop.Pages.JobDetails.DeleteModel
@{
    ViewData["Title"] = "Delete Job";
}
<h1>Delete Job</h1>
<h2>Do You want to delete this job?</h2>
<div>
    <h2>Job List</h2>
    <dl>
        <dt >Job Title</dt>
        <dd >@Model.JobPost.Jobtitle</dd>
    </dl>
    <dl>
        <dt>Company</dt>
        <dd>@Model.JobPost.Company</dd>
    </dl>
    <dl>
        <dt>Location</dt>
        <dd>@Model.JobPost.Location</dd>
    </dl>
    <dl>
        <dt>Employment Type</dt>
        <dd>@Model.JobPost.Employmenttype</dd>
    </dl>
    <dl>
        <dt>Salary</dt>
        <dd>@Model.JobPost.Salary</dd>
    </dl>
</div>
<div class="form-group">
<form method="post">
        <input type="hidden" asp-for="JobPost.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
</div>
