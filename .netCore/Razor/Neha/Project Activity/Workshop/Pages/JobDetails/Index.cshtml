@page
@model Workshop.Pages.JobDetails.IndexModel
@{
}
<h1>Job Listing</h1>
<a asp-page="Create" class="btn btn-primary">Create New Job</a>
<table>
    <thead>
        <tr>
            <th>Job Title</th>
            <th>Company</th>
            <th>Location</th>
            <th>Employment type</th>
            <th>Salary Range</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var det in Model.JobPosts)
        {
            <tr>
                <td>@det.Jobtitle</td>
                <td>@det.Company</td>
                <td>@det.Location</td>
                <td>@det.Employmenttype</td>
                <td>@det.Salary</td>
                <td>
                  <a asp-page="Edit" asp-route-id="@det.Id" class="btn btn-warning">Edit</a>
                    <a asp-page="Details" asp-route-id="@det.Id" class="btn btn-info">Details</a>
                    <a asp-page="Delete" asp-route-id="@det.Id" class="btn btn-danger">Delete</a>


                </td>
            </tr>
        }
    </tbody>
</table>
