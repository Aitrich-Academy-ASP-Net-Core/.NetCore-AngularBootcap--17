@page
@model WebApplication1.Pages.Mypage.IndexModel
@{
}
<h1>List Students</h1>

<form method="get" class="form-inline mb-3">
    <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search by name..." class="form-control mr-2" />
    <button type="submit" class="btn btn-primary">Search</button>
    <a asp-page="Index" class="btn btn-secondary ml-2">Reset</a>
</form>

<a class="btn btn-success mb-3" asp-page="Create">Add New Student</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Student Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Course</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stud in Model.students)
        {
            <tr>
                <td>@stud.Id</td>
                <td>@stud.Name</td>
                <td>@stud.Age</td>
                <td>@stud.Course</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@stud.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-page="Delete" asp-route-id="@stud.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

