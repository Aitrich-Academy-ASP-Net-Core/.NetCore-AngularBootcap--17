@page
@model AppliedJobs.Pages.MyPage.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<h2 class="text-center">Register</h2>

<form method="post" class="login-form" style="max-width: 400px; margin: auto; padding: 20px; border: 1px solid #ddd; border-radius: 8px;">
    <div class="form-group" style="margin-bottom: 15px;">
        <label>Username</label>
        <input asp-for="RegisterUser.Username" class="form-control" style="width: 100%; padding: 8px;" />
    </div>
    <div class="form-group" style="margin-bottom: 15px;">
        <label>Email</label>
        <input asp-for="RegisterUser.Email" class="form-control" style="width: 100%; padding: 8px;" />
    </div>
    <div class="form-group" style="margin-bottom: 15px;">
        <label>Password</label>
        <input asp-for="RegisterUser.Password" type="password" class="form-control" style="width: 100%; padding: 8px;" />
    </div>
    <button type="submit" class="btn btn-primary" style="width: 100%; background-color: #007bff; color: white; padding: 10px; border: none; border-radius: 4px;">Register</button>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p style="text-align: center; color: red; margin-top: 15px;"
    >@Model.Message</p>
}
<p>Already registered? <a asp-page="/MyPage/Login">Login here</a></p>
