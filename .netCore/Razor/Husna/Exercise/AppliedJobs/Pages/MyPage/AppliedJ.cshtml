@page
@model AppliedJobs.Pages.MyPage.AppliedJModel
@{
    ViewData["Title"] = "Applied Jobs";
}

<h2>Jobs You Have Applied For</h2>
<div>
    <a asp-page="/MyPage/Index">Back to Job Listings</a>
</div>

@if (Model.AppliedJobs != null && Model.AppliedJobs.Count > 0)
{
    <table>
        <thead>
            <tr>
                <th>Job Title</th>
                <th>Location</th>
                <th>Applied On</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model.AppliedJobs)
            {
                <tr>
                    <td>@job.JobTitle</td>
                    <td>@job.Location</td>
                    <td>@job.AppliedOn.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>You haven't applied to any jobs yet.</p>
}
