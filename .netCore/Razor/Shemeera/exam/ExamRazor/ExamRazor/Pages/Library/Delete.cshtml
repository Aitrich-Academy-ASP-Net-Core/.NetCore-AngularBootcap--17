@page "{Id:int}"
@model ExamRazor.Pages.Library.DeleteModel
@{
}
<h2>Delete Book</h2>

<p>Are you sure you want to delete the book titled "<strong>@Model.BookToDelete.Title</strong>" by @Model.BookToDelete.Author?</p>

<form method="post">
    <button type="submit">Yes, Delete</button>
    <a href="/BookList">Cancel</a>
</form>