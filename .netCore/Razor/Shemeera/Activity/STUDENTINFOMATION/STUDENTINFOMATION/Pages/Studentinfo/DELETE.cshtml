@page "{Id:int}"
@model STUDENTINFOMATION.Pages.Studentinfo.DELETEModel
@{
}
<h2>Delete Student</h2>
<p>Are you sure you want to delete this Student?</p>

<div>
    <strong>Name:</strong> @Model.Student.StudentName
</div>

<div>
    <strong>Email:</strong> @Model.Student.StudentEmail
</div>

<div>
    <strong>Course:</strong> @Model.Student.Course
</div>

<form method="post">
    <input type="hidden" asp-for="Student.StudentId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>