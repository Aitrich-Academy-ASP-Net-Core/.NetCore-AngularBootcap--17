@page
@model DTONewProject.Pages.Jobdata.AddJobModel
@{
}



<h2>create Job</h2>
<form action="/" method="post">
<div class="form-group">
    <label asp-for="Jobs.JobTitle">JobId</label> 
    <input asp-for="Jobs.JobTitle" class="form-control" />
    <span asp-validation-for="Jobs.JobTitle" class=" text-black" /></span>
</div>
    <div class="form-group">
        <label asp-for="Jobs.Company">Company</label>
        <input asp-for="Jobs.Company" class="form-control" />
        <span asp-validation-for="Jobs.Company" class=" text-black" /></span>
    </div>
<div class="form-group">
        <label asp-for="Jobs.Location">Location</label>
        <input asp-for="Jobs.Location" class="form-control" />
        <span asp-validation-for="Jobs.Location" class=" text-black" /></span>
    </div
<div class="form-group">
        <label asp-for="Jobs.JobType">JobType</label>
        <input asp-for="Jobs.JobType" class="form-control" />
        <span asp-validation-for="Jobs.JobType" class=" text-black" /></span>
    </div
</form>
<div>
    <form method="post">
    <button type="submit" class="btn btn-outline-primary">Create</button>
    </form>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</div>
