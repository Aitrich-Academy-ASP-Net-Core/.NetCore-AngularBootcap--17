@page "{id:int}"
@model razorrpagesneww.Pages.Studentss.DeleteeModeModel
@{
}



<h2>Delete Student</h2>
<p>Are you sure you want to delete this Student?</p>
<div>
    <strong>Name:</strong> @Model.student.FullName
</div>
<div>
    <strong>Position:</strong> @Model.student.DateOfBirth
</div>
<div>
    <strong>Salary:</strong> @Model.student.Email
</div>
<div>
    <strong>Department:</strong> @Model.student.Phone
</div>
<div>
    <form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    </form>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</div>
