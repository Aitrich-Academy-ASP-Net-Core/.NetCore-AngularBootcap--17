

@page
@model IndexModel
@{
    
}

<h1>Select a Country</h1>

<form method="post">
    <div>
        <label asp-for="SelectedCountry">Choose a country:</label>
        <select asp-for="SelectedCountry" asp-items="@Model.CountryList" class="form-control">
            <option value="">-- Select a Country --</option>
        </select>
        <span asp-validation-for="SelectedCountry" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Submit</button>
</form>

@if (!string.IsNullOrEmpty(Model.SelectedCountry))
{
    <div class="mt-3">
        <h4>Selected Country: @Model.SelectedCountry</h4>
    </div>
}