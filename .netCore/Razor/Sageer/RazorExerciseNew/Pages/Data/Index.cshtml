@page
@model RazorExerciseNew.Pages.Data.IndexModel
@{
}
@page
@model RazorPagesJobApp.Pages.Jobs.IndexModel
@{
    ViewData["Title"] = "Job Listings";
}

<h1>Job Listings</h1>

<div class="job-list">
    @foreach (var job in Model.Jobs)
    {
        <div class="job-card">
            <h3>@job.Title</h3>
            <p><strong>Company:</strong> @job.Company</p>
            <p><strong>Location:</strong> @job.Location</p>
            <p><strong>Description:</strong> @job.Description</p>
            <p><strong>Posted:</strong> @job.PostedDate.ToShortDateString()</p>
            <a asp-page="/Jobs/Apply" asp-route-id="@job.Id" class="btn">Apply</a>
        </div>
    }
</div>